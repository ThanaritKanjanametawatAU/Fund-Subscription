{
  "version": 2,
  "builds": [
    { 
      "src": "api/index.py", 
      "use": "@vercel/python",
      "config": {
        "pythonVersion": "3.9"
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    { "src": "/api/process", "dest": "/api/index.py" },
    { "src": "/api/download", "dest": "/api/index.py" },
    { "src": "/api/debug", "dest": "/api/index.py" },
    { "src": "/api", "dest": "/api/index.py" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}